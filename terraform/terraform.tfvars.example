project_id = "your-project-id"
location   = "us-central1"
gateway_id = "demo-egress-gw"

# DRY_RUN first. Flip to ENFORCED once `1-setup-gateway.sh logs` shows no unexpected denials.
enforcement_mode = "DRY_RUN"

